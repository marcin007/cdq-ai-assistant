#!/bin/sh
set -eu

state=${LOCAL_OPS_FAKE_STATE:?}
if [ "${1:-}" = 'info' ]; then
    [ "$(sed -n '1p' "$state/docker-daemon")" = 'ok' ]
    exit
fi

[ "${1:-}" = 'compose' ] || exit 2
shift

if [ "${1:-}" = 'version' ]; then
    printf '%s\n' 'Docker Compose version v2.29.0'
    exit 0
fi

if [ "${1:-}" = '-f' ]; then
    shift 2
fi

case "${1:-}" in
    up)
        printf '%s\n' 'compose up' >> "$state/events"
        ;;
    exec)
        [ "$*" = 'exec -T pgvector sh -c pg_isready -U "$POSTGRES_USER" -d "$POSTGRES_DB"' ] \
            || exit 2
        printf '%s\n' 'compose health' >> "$state/events"
        ;;
    logs)
        printf '%s\n' 'fixture pgvector log'
        ;;
    stop)
        printf '%s\n' 'compose stop' >> "$state/events"
        ;;
    down)
        printf '%s\n' 'compose down' >> "$state/events"
        printf '%s\n' "$*" >> "$state/events"
        ;;
    *)
        exit 2
        ;;
esac
